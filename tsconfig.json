{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "strict": false,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "ignoreDeprecations": "6.0"
    },
    "include": ["*.ts", "src/**/*.ts", "../circuits/src/**/*.ts"],
    "exclude": [
        "node_modules",
        "../circuits/src/**/*.test.ts"
    ]
}
