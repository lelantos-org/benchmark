{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "strict": false,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "ts-node": {
        "esm": true,
        "transpileOnly": true,
        "experimentalSpecifierResolution": "node"
    },
    "include": ["src/**/*.ts", "*.ts"],
    "exclude": ["node_modules"]
}
